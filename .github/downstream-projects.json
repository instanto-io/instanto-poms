            "if [ -n \"${MAVEN_CENTRAL_MIRROR_URL:-}\" ]; then mkdir -p \"$GRADLE_USER_HOME/init.d\"; cat > \"$GRADLE_USER_HOME/init.d/central-mirror.gradle\" <<'GRADLE'\nString mirror = System.getenv(\"MAVEN_CENTRAL_MIRROR_URL\")\nif (mirror != null && !mirror.isEmpty()) {\n    beforeSettings { settings ->\n        settings.pluginManagement.repositories.configureEach { repo ->\n            if (repo instanceof org.gradle.api.artifacts.repositories.MavenArtifactRepository) {\n                String url = repo.url.toString()\n                if (url.startsWith(\"https://repo.maven.apache.org/maven2\") || url.startsWith(\"https://repo1.maven.org/maven2\")) {\n                    repo.setUrl(java.net.URI.create(mirror))\n                }\n            }\n        }\n    }\n    allprojects { project ->\n        project.repositories.configureEach { repo ->\n            if (repo instanceof org.gradle.api.artifacts.repositories.MavenArtifactRepository) {\n                String url = repo.url.toString()\n                if (url.startsWith(\"https://repo.maven.apache.org/maven2\") || url.startsWith(\"https://repo1.maven.org/maven2\")) {\n                    repo.setUrl(java.net.URI.create(mirror))\n                }\n            }\n        }\n    }\n}\nGRADLE\nfi\nfor attempt in 1 2 3 4 5; do if ./gradlew --no-daemon --version; then break; fi; [ \"$attempt\" -lt 5 ] || exit 1; rm -rf \"$GRADLE_USER_HOME/wrapper/dists\"; export JAVA_TOOL_OPTIONS=\"${JAVA_TOOL_OPTIONS:-} -Djava.net.preferIPv4Stack=true\"; sleep 5; done\n./gradlew --no-daemon check publishToMavenLocal"
          ],
          "env": {
            "GRADLE_USER_HOME": "{runner_temp}/teacoco-gradle"
          }
        }
      ]
    },
