<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.instanto</groupId>
  <artifactId>instanto-org-pom</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Instanto Organisation Parent</name>
  <description>Shared Maven build and release settings for Instanto libraries and applications.</description>

  <!-- ── Role ────────────────────────────────────────────────────────────
       The root build contract for every Instanto project, whatever it compiles to.
       Everything here applies equally to a browser library, a server service and
       a plain JVM utility.

       Provides  Java 21 and UTF-8 defaults; pinned versions for the standard
                 Maven plugins; source and Javadoc archives attached to every
                 build including snapshots; Spotless formatting and SpotBugs
                 reporting on every module; the release, sign-release and
                 central profiles.

       Publishing  Snapshots go to the Instanto Forgejo registry. Release
                 versions go to Maven Central through the Central Publisher
                 Portal.

                     mvn deploy                              snapshot
                     mvn -P release,sign-release deploy      release
       Requires  Nothing. A project inherits this POM and builds.
       Supplies  Each repository declares its own SCM. The shared snapshot
        itself  registry and release publisher are inherited from this POM.
       Not here  Library dependencies, BOM imports, and anything specific to a
                 toolchain. TeaVM lives in instanto-teavm-pom.
  -->
  <url>https://instanto.io</url>
  <organization>
    <name>Instanto</name>
    <url>https://instanto.io</url>
  </organization>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <!-- Parents published from this repository. This POM stays platform-neutral;
       anything tied to a particular toolchain lives in a module beside it. -->
  <modules>
    <module>instanto-teavm-pom</module>
  </modules>

  <!-- Snapshot publication stays inside Instanto. The Central extension below
       captures release versions and uploads them to the Publisher Portal. -->
  <distributionManagement>
    <snapshotRepository>
      <id>forgejo</id>
      <name>Instanto snapshots</name>
      <url>https://packages.instanto.io/api/packages/instanto-io/maven</url>
    </snapshotRepository>
  </distributionManagement>

  <repositories>
    <repository>
      <id>forgejo</id>
      <name>Instanto snapshots</name>
      <url>https://packages.instanto.io/api/packages/instanto-io/maven</url>
      <releases><enabled>false</enabled></releases>
      <snapshots><enabled>true</enabled></snapshots>
    </repository>
  </repositories>

  <pluginRepositories>
    <pluginRepository>
      <id>forgejo</id>
      <name>Instanto snapshot build plugins</name>
      <url>https://packages.instanto.io/api/packages/instanto-io/maven</url>
      <releases><enabled>false</enabled></releases>
      <snapshots><enabled>true</enabled></snapshots>
    </pluginRepository>
  </pluginRepositories>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
    <maven-install-plugin.version>3.1.4</maven-install-plugin.version>
    <maven-deploy-plugin.version>3.1.4</maven-deploy-plugin.version>
    <maven-surefire-plugin.version>3.6.0-M1</maven-surefire-plugin.version>
    <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
    <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
    <maven-release-plugin.version>3.3.1</maven-release-plugin.version>
    <versions-maven-plugin.version>2.19.1</versions-maven-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
    <spotless.version>2.43.0</spotless.version>
    <google-java-format.version>1.35.0</google-java-format.version>
    <spotbugs-maven-plugin.version>4.10.3.0</spotbugs-maven-plugin.version>
    <maven-antrun-plugin.version>3.2.0</maven-antrun-plugin.version>
    <central-publishing-maven-plugin.version>0.11.0</central-publishing-maven-plugin.version>
  </properties>

  <!-- No library dependencies or BOM imports belong in this parent. -->
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <encoding>${project.build.sourceEncoding}</encoding>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>${maven-install-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>${maven-deploy-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>${maven-source-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>${maven-javadoc-plugin.version}</version>
          <configuration>
            <!-- Javadoc runs on every module, including GWT stubs, classlib overrides and
                 generated code that were never written for it. Attach the jar without
                 letting comment style fail the build. failOnError covers what doclint
                 does not, such as a {@link} to a class outside the module's classpath. -->
            <doclint>none</doclint>
            <failOnError>false</failOnError>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-release-plugin</artifactId>
          <version>${maven-release-plugin.version}</version>
          <configuration>
            <autoVersionSubmodules>true</autoVersionSubmodules>
            <pushChanges>false</pushChanges>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>versions-maven-plugin</artifactId>
          <version>${versions-maven-plugin.version}</version>
          <configuration>
            <generateBackupPoms>false</generateBackupPoms>
            <processAllModules>true</processAllModules>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-gpg-plugin</artifactId>
          <version>${maven-gpg-plugin.version}</version>
          <configuration><bestPractices>true</bestPractices></configuration>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
          <configuration>
            <java>
              <includes>
                <include>src/main/java/**/*.java</include>
                <include>src/test/java/**/*.java</include>
              </includes>
              <excludes>
                <exclude>**/generated/**</exclude>
                <exclude>**/generated-sources/**</exclude>
                <exclude>**/vendor/**</exclude>
                <exclude>**/upstream/**</exclude>
              </excludes>
              <googleJavaFormat><version>${google-java-format.version}</version></googleJavaFormat>
              <removeUnusedImports/>
            </java>
          </configuration>
          <executions>
            <execution>
              <id>format-java</id>
              <phase>validate</phase>
              <goals><goal>apply</goal></goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.sonatype.central</groupId>
          <artifactId>central-publishing-maven-plugin</artifactId>
          <version>${central-publishing-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>com.github.spotbugs</groupId>
          <artifactId>spotbugs-maven-plugin</artifactId>
          <version>${spotbugs-maven-plugin.version}</version>
          <configuration>
            <effort>Max</effort>
            <threshold>Low</threshold>
            <!-- Max effort on a module of a few hundred generated classes exhausts
                 the analyser's default heap. -->
            <maxHeap>2048</maxHeap>
            <xmlOutput>true</xmlOutput>
            <spotbugsXmlOutputDirectory>${project.build.directory}/spotbugs</spotbugsXmlOutputDirectory>
            <spotbugsXmlOutputFilename>${project.artifactId}-spotbugs.xml</spotbugsXmlOutputFilename>
            <sarifOutput>true</sarifOutput>
            <sarifOutputDirectory>${project.build.directory}/spotbugs</sarifOutputDirectory>
            <sarifOutputFilename>${project.artifactId}-spotbugs.sarif</sarifOutputFilename>
            <htmlOutput>true</htmlOutput>
            <outputDirectory>${project.build.directory}/spotbugs</outputDirectory>
            <failOnError>true</failOnError>
          </configuration>
          <executions>
            <execution>
              <id>spotbugs-report</id>
              <phase>process-classes</phase>
              <goals><goal>spotbugs</goal></goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-antrun-plugin</artifactId>
          <version>${maven-antrun-plugin.version}</version>
          <executions>
            <execution>
              <!-- SpotBugs always writes spotbugs.html; give it the module's name
                   so reports collected from a reactor stay distinguishable. -->
              <id>name-spotbugs-html-report</id>
              <phase>process-classes</phase>
              <goals><goal>run</goal></goals>
              <configuration>
                <target>
                  <move todir="${project.build.directory}/spotbugs">
                    <fileset dir="${project.build.directory}/spotbugs" includes="spotbugs.html" erroronmissingdir="false"/>
                    <globmapper from="spotbugs.html" to="${project.artifactId}-spotbugs.html"/>
                  </move>
                </target>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
    <!-- Formatting and static analysis run for every Instanto build, whatever
         the project's toolchain. SpotBugs reports; it does not fail on findings.
         Sources and javadoc are attached for every build, snapshot included.
         Only signing is gated, by the sign-release profile. -->
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-sources</id>
            <phase>package</phase>
            <goals><goal>jar-no-fork</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <phase>package</phase>
            <goals><goal>jar</goal></goals>
          </execution>
        </executions>
      </plugin>
      <!-- The extension publishes release versions to Maven Central. Snapshot
           versions continue through distributionManagement to Forgejo. -->
      <plugin>
        <groupId>org.sonatype.central</groupId>
        <artifactId>central-publishing-maven-plugin</artifactId>
        <extensions>true</extensions>
        <configuration>
          <publishingServerId>central</publishingServerId>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <executions>
              <execution>
                <id>check-release-inputs</id>
                <phase>validate</phase>
                <goals><goal>enforce</goal></goals>
                <configuration>
                  <rules>
                    <requireReleaseVersion/>
                    <requireReleaseDeps/>
                    <requireJavaVersion><version>[21,)</version></requireJavaVersion>
                    <requireMavenVersion><version>[3.9.2,4)</version></requireMavenVersion>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>sign-release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <executions>
              <execution>
                <id>sign-release-files</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
