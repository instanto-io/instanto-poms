<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>instanto-org-pom</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>instanto-teavm-pom</artifactId>
  <packaging>pom</packaging>
  <name>Instanto TeaVM Parent</name>
  <description>One TeaVM version, dependency set and plugin pin for Instanto projects that compile to the browser.</description>

  <!-- ── Role ────────────────────────────────────────────────────────────
       The TeaVM layer for projects that compile Java to JavaScript or WebAssembly.
       It adds TeaVM and Instanto's TeaVM additions; everything an ordinary
       Instanto Java build needs still arrives from instanto-org-pom above it.

       Provides  The teavm.version property; managed versions for every
                 org.teavm artifact the organisation uses, so a module can
                 declare them without a <version>; a pluginManagement pin for
                 teavm-maven-plugin, which also makes every TeaVM compile
                 write a source map and copy the Java sources it maps to.
                 Compiler minification is disabled; applications can opt into
                 the managed Terser execution for their final assets.
                 Managed versions for instanto-teavm-classlib (missing class
                 library methods and fixes) and instanto-teavm-extensions (JUnit
                 rule support, opt-in ThreadLocal checks), which a module adds
                 as a dependency when it wants them. The teavm-compiler-fixes
                 profile, on unless -Dinstanto.teavm.stockCompiler is set, puts
                 the patched TeaVM core and JSO implementation in place of
                 upstream's for compiles and tests. The opt-in
                 teavm-browser-tests profile runs compiled tests in Chrome.
       Requires  Source archives for the libraries an application compiles,
                 which instanto-org-pom attaches to every build.
       Not here  The rest of TeaVM build configuration. Targets, optimisation
                 level and output directory belong to each application parent,
                 which knows what it is producing.

       A project that cannot change its parent may import this POM into
       dependencyManagement with <type>pom</type><scope>import</scope>. An
       import carries the managed versions only — not the property, and not
       the plugin pin or its source-map defaults.
  -->

  <properties>
    <teavm.version>0.16.0</teavm.version>
    <!-- Instanto's TeaVM additions, published from instanto-io/instanto-teavm. -->
    <instanto-teavm.version>0.1.0-SNAPSHOT</instanto-teavm.version>
    <instanto.teavm.threadLocalChecks>false</instanto.teavm.threadLocalChecks>
    <!-- JavaScript is minified after compilation, with Terser. Applications opt
         in by setting the directory, filename and lifecycle phase below. -->
    <instanto.terser.version>5.51.2</instanto.terser.version>
    <instanto.terser.executable>npx</instanto.terser.executable>
    <instanto.terser.phase>none</instanto.terser.phase>
    <instanto.terser.skip>false</instanto.terser.skip>
    <instanto.terser.directory>${project.build.directory}/javascript</instanto.terser.directory>
    <instanto.terser.file>classes.js</instanto.terser.file>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Instanto's TeaVM additions: class-library methods and fixes, and JUnit
           rule support with opt-in ThreadLocal checks. -->
      <dependency>
        <groupId>io.instanto</groupId>
        <artifactId>instanto-teavm-classlib</artifactId>
        <version>${instanto-teavm.version}</version>
      </dependency>
      <dependency>
        <groupId>io.instanto</groupId>
        <artifactId>instanto-teavm-extensions</artifactId>
        <version>${instanto-teavm.version}</version>
      </dependency>

      <!-- Portable runtime: compiled against by code that targets the browser. -->
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-classlib</artifactId>
        <version>${teavm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-jso</artifactId>
        <version>${teavm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-jso-apis</artifactId>
        <version>${teavm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-interop</artifactId>
        <version>${teavm.version}</version>
      </dependency>

      <!-- Compiler and tooling: needed by code that drives a TeaVM build. -->
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-core</artifactId>
        <version>${teavm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-tooling</artifactId>
        <version>${teavm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-devserver</artifactId>
        <version>${teavm.version}</version>
      </dependency>

      <!-- Metaprogramming and compiler extensions. These are compile-time only:
           declare them provided so they stay off a consumer's runtime classpath. -->
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-metaprogramming-api</artifactId>
        <version>${teavm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-extension-spi</artifactId>
        <version>${teavm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-extension-apis</artifactId>
        <version>${teavm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-extension-annotation-processor</artifactId>
        <version>${teavm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-relocated-libs-asm</artifactId>
        <version>${teavm.version}</version>
      </dependency>

      <!-- Extras -->
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-extras-slf4j</artifactId>
        <version>${teavm.version}</version>
      </dependency>

      <!-- Test -->
      <dependency>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-junit</artifactId>
        <version>${teavm.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!-- Every TeaVM application is debuggable in the browser as Java: the
             compiler writes a source map beside the script and copies the
             sources it names. Each application parent configures its own
             targets, optimisation level and output directory. -->
        <plugin>
          <groupId>org.teavm</groupId>
          <artifactId>teavm-maven-plugin</artifactId>
          <version>${teavm.version}</version>
          <configuration>
            <minifying>false</minifying>
            <sourceMapsGenerated>true</sourceMapsGenerated>
            <sourceFilesCopied>true</sourceFilesCopied>
            <properties>
              <instanto.teavm.threadLocalChecks>${instanto.teavm.threadLocalChecks}</instanto.teavm.threadLocalChecks>
            </properties>
          </configuration>
        </plugin>
        <!-- Declare this plugin after TeaVM in an application's build. Keeping
             the filename and composing its source map preserves asset URLs and
             Java debugging. No property mangling or top-level renaming. -->
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.6.3</version>
          <executions>
            <execution>
              <id>minify-teavm-js</id>
              <phase>${instanto.terser.phase}</phase>
              <goals><goal>exec</goal></goals>
              <configuration combine.self="override">
                <skip>${instanto.terser.skip}</skip>
                <executable>${instanto.terser.executable}</executable>
                <workingDirectory>${instanto.terser.directory}</workingDirectory>
                <arguments>
                  <argument>--yes</argument>
                  <argument>--package=terser@${instanto.terser.version}</argument>
                  <argument>--</argument>
                  <argument>terser</argument>
                  <argument>${instanto.terser.file}</argument>
                  <argument>--compress</argument>
                  <argument>--mangle</argument>
                  <argument>--source-map</argument>
                  <argument>content='${instanto.terser.file}.map',url='${instanto.terser.file}.map'</argument>
                  <argument>--output</argument>
                  <argument>${instanto.terser.file}</argument>
                </arguments>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
  <profiles>
    <!-- Version-bound compiler corrections from instanto-teavm, on for every build:
         instanto-teavm-core-patch keeps class initialisation on exception paths, and
         instanto-teavm-jso-patch makes @JSTopLevel calls plain global calls instead of
         calls on null. Each is the complete upstream 0.16.0 jar with the faulty classes
         replaced. No application dependency on Sarto or JUnit is introduced. Build with
         -Dinstanto.teavm.stockCompiler to use upstream TeaVM unchanged. -->
    <profile>
      <id>teavm-compiler-fixes</id>
      <activation>
        <property><name>!instanto.teavm.stockCompiler</name></property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>io.instanto</groupId>
          <artifactId>instanto-teavm-core-patch</artifactId>
          <version>${instanto-teavm.version}</version>
          <scope>test</scope>
        </dependency>
        <!-- TeaVM loads its JSO implementation from the project's classpath, not the
             plugin's, and does not order that classpath by declaration. So this patch
             is a provided dependency, and teavm-classlib is managed below without the
             upstream teavm-jso-impl, leaving the patch as the only implementation. -->
        <dependency>
          <groupId>io.instanto</groupId>
          <artifactId>instanto-teavm-jso-patch</artifactId>
          <version>${instanto-teavm.version}</version>
          <scope>provided</scope>
        </dependency>
      </dependencies>
      <dependencyManagement>
        <dependencies>
          <dependency>
            <groupId>org.teavm</groupId>
            <artifactId>teavm-classlib</artifactId>
            <version>${teavm.version}</version>
            <exclusions>
              <exclusion><groupId>org.teavm</groupId><artifactId>teavm-jso-impl</artifactId></exclusion>
            </exclusions>
          </dependency>
        </dependencies>
      </dependencyManagement>
      <build>
        <pluginManagement><plugins><plugin>
          <groupId>org.teavm</groupId><artifactId>teavm-maven-plugin</artifactId>
          <dependencies>
            <dependency>
              <groupId>io.instanto</groupId><artifactId>instanto-teavm-core-patch</artifactId>
              <version>${instanto-teavm.version}</version>
            </dependency>
          </dependencies>
        </plugin></plugins></pluginManagement>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <!-- Each patch contains the complete upstream jar, with only the
                   faulty classes replaced. Excluding the originals avoids depending
                   on a consumer's project dependency declaration order. -->
              <classpathDependencyExcludes>
                <classpathDependencyExclude>org.teavm:teavm-core</classpathDependencyExclude>
                <classpathDependencyExclude>org.teavm:teavm-jso-impl</classpathDependencyExclude>
              </classpathDependencyExcludes>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId>
            <executions><execution>
              <id>teavm-compiler-fixes-version</id><phase>validate</phase><goals><goal>enforce</goal></goals>
              <configuration><rules><requireProperty>
                <property>teavm.version</property><regex>0\.16\.0</regex>
                <message>The TeaVM compiler fixes require TeaVM 0.16.0; build with -Dinstanto.teavm.stockCompiler before changing TeaVM versions.</message>
                <regexMessage>The TeaVM compiler fixes require TeaVM 0.16.0; build with -Dinstanto.teavm.stockCompiler before changing TeaVM versions.</regexMessage>
              </requireProperty></rules></configuration>
            </execution></executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- Select this only in modules containing TeaVM browser tests. The extension
         is still a separate dependency, and its checks are still opt-in. -->
    <profile>
      <id>teavm-browser-tests</id>
      <properties>
        <teavm.junit.js>true</teavm.junit.js>
        <teavm.junit.wasm-gc>true</teavm.junit.wasm-gc>
        <teavm.junit.c>false</teavm.junit.c>
        <teavm.junit.optimized>true</teavm.junit.optimized>
        <teavm.junit.minified>false</teavm.junit.minified>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <teavm.junit.target>${project.build.directory}/teavm-tests</teavm.junit.target>
                <teavm.junit.js>${teavm.junit.js}</teavm.junit.js>
                <teavm.junit.wasm-gc>${teavm.junit.wasm-gc}</teavm.junit.wasm-gc>
                <teavm.junit.c>${teavm.junit.c}</teavm.junit.c>
                <teavm.junit.optimized>${teavm.junit.optimized}</teavm.junit.optimized>
                <teavm.junit.minified>${teavm.junit.minified}</teavm.junit.minified>
                <teavm.junit.js.runner>browser-chrome</teavm.junit.js.runner>
                <teavm.junit.wasm-gc.runner>browser-chrome</teavm.junit.wasm-gc.runner>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
